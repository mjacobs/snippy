{
  "manifest_version": 3,
  "name": "Snippy",
  "version": "1.1.1",
  "minimum_chrome_version": "116",
  "description": "A beautiful, fast, and easy screenshot tool. Select any area, edit with arrows, shapes, text, or blurs, and save as JPEG.",
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "downloads",
    "nativeMessaging",
    "offscreen",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://*.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "Take a Screenshot (Ctrl+Shift+S)"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
         "default": "Ctrl+Shift+S",
         "mac": "Command+Shift+S"
      },
      "description": "Trigger Snippy selection"
    },
    "quick_snip": {
      "suggested_key": {
         "default": "Ctrl+Shift+E",
         "mac": "Command+Shift+E"
      },
      "description": "Quick Snip — save temp JPEG and copy its file path"
    },
    "full_capture": {
      "suggested_key": {
         "default": "Ctrl+Shift+F",
         "mac": "Command+Shift+F"
      },
      "description": "Full Capture — whole visible tab straight to editor"
    }
  }
}
